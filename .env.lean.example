# NewAPI lean deployment example for small servers.
# Copy this file to your private .env on the server and replace every placeholder.
# Do not commit real .env files, API keys, database passwords, customer data, or logs.

PORT=3000
TZ=Asia/Shanghai
NODE_TYPE=master

# Database. Use a strong private password in your real .env.
SQL_DSN=postgresql://newapi:change-this-password@postgres:5432/newapi
LOG_SQL_DSN=
SQL_MAX_IDLE_CONNS=2
SQL_MAX_OPEN_CONNS=20
SQL_MAX_LIFETIME=300

# Single-node lean mode: keep Redis and memory cache disabled unless required.
REDIS_CONN_STRING=
MEMORY_CACHE_ENABLED=false
SYNC_FREQUENCY=300
BATCH_UPDATE_ENABLED=false

# Startup/task slimming.
CHANNEL_UPSTREAM_MODEL_UPDATE_TASK_ENABLED=false
UPDATE_TASK=true
TASK_QUERY_LIMIT=50
TASK_TIMEOUT_MINUTES=1440
BILLING_STATEMENT_AUTO_ENABLED=false

# Request limits suitable for a 2C4G host. Adjust only after load testing.
RELAY_MAX_IDLE_CONNS=50
RELAY_MAX_IDLE_CONNS_PER_HOST=10
RELAY_TIMEOUT=120
MAX_REQUEST_BODY_MB=8
STREAM_SCANNER_MAX_BUFFER_MB=16
MAX_FILE_DOWNLOAD_MB=10
GET_MEDIA_TOKEN=false
GET_MEDIA_TOKEN_NOT_STREAM=false

# Production security. Replace all placeholders in your private .env.
SESSION_SECRET=replace-with-32-byte-random
CRYPTO_SECRET=replace-with-another-32-byte-random
SETUP_TOKEN=replace-with-one-time-setup-token
CORS_ALLOW_ORIGINS=https://your-domain.example
TRUSTED_PROXIES=127.0.0.1
TLS_INSECURE_SKIP_VERIFY=false
ENABLE_PPROF=false
PYROSCOPE_URL=

# Seedance 2.0 billing guardrails. Do not place model API keys here unless your
# deployment code explicitly supports env-based upstream key loading.
SEEDANCE_BILLING_BY_USAGE=true
SEEDANCE_BILLING_STRICT_USAGE=false
SEEDANCE_REQUIRE_PRICE_CONFIRMATION=true
SEEDANCE_PRICE_CONFIRMED=true
SEEDANCE_DEFAULT_DURATION=5
SEEDANCE_MAX_DURATION=60
SEEDANCE_MAX_IMAGES=4
SEEDANCE_MAX_REFERENCE_VIDEOS=1
SEEDANCE_REMOTE_URL_ALLOWLIST=cdn.example.com,*.oss-cn-hangzhou.aliyuncs.com
SEEDANCE_CALLBACK_URL_ALLOWLIST=hooks.example.com
REQUIRE_REMOTE_ALLOWLIST=true
REQUIRE_CALLBACK_ALLOWLIST=false

# Open source license and source code access disclosure.
# Replace these placeholders in the private deployment .env.
SOURCE_CODE_URL=https://your-domain.example/source-code
LEGAL_CONTACT_EMAIL=opensource@example.com
MODIFIER_NAME=Your Name or Organization
MODIFIED_VERSION=your-version
MODIFIED_DATE=YYYY-MM-DD
MODIFICATION_SUMMARY=Lean deployment changes and service customization based on New API.
UPSTREAM_PROJECT_NAME=New API
UPSTREAM_MAINTAINER=QuantumNous
UPSTREAM_LICENSE=GNU Affero General Public License v3.0
BASED_ON_PROJECT=One API
BASED_ON_LICENSE=MIT License
